# ─────────────────────────────────────────────────────────────────────────────
# HERMICAD — متغیرهای محیطی
#
# این فایل یک الگو است: برای استفاده، آن را به `.env.local` کپی کنید.
# هیچ مقدار محرمانه‌ای را در `.env.example` ننویسید.
# ─────────────────────────────────────────────────────────────────────────────

# ── پایگاه داده ──────────────────────────────────────────────────────────────
# در توسعه، بدون DATABASE_URL از PGlite (فایل‌محور) استفاده می‌شود.
# در production (NODE_ENV=production) نبودِ DATABASE_URL باعث خطای صریح می‌شود
# (fail-closed) مگر اینکه صریحاً اجازهٔ PGlite داده شود — که راهکار تولیدی نیست.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hermicad
# PGLITE_DATA_DIR=.data/hermicad
# فقط برای پیش‌نمایش تک‌فرایندیِ تولیدروی:
# HERMICAD_ALLOW_PGLITE_IN_PRODUCTION=1

# ── سقف مصرف هر فضای کار (ضد سوءمصرف برای انتشار عمومی رایگان) ───────────────
# HERMICAD_QUOTA_PROJECTS=200
# HERMICAD_QUOTA_DESIGNS=300

# ── کارایی ───────────────────────────────────────────────────────────────────
# مدت اعتبار کش آزمون کیفیت (میلی‌ثانیه). پیش‌فرض ۱۵۰۰۰.
# صفر یعنی کش غیرفعال. /quality و /api/quality از همین مقدار استفاده می‌کنند.
# HERMICAD_QUALITY_TTL_MS=15000

# ── نگهداشت داده ─────────────────────────────────────────────────────────────
# حداکثر تعداد اجرای تولیدِ نگه‌داشته‌شده برای هر پروژه (به‌جز اجرای فعال).
# هر اجرای پنج‌گونه‌ای حدود ۱ مگابایت مصرف می‌کند؛ با این سقف رشد نامحدود
# جلوی گرفته می‌شود. پیش‌فرض ۲۰.
# HERMICAD_RUN_RETENTION=20

# ── استقرار ──────────────────────────────────────────────────────────────────
# دامنهٔ عمومی سایت برای robots.txt، sitemap.xml و آدرس‌های مطلق در متادیتا.
# اگر تنظیم نشود، دامنه از سرآیندهای درخواست (Host / X-Forwarded-Host) خوانده
# می‌شود؛ در استقرار پشت پراکسی، تنظیم صریح آن توصیه می‌شود.
# HERMICAD_PUBLIC_URL=https://hermicad.example.com
