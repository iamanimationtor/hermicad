# HERMICAD environment
# در توسعه بدون DATABASE_URL از PGlite (فایل‌محور در .data/hermicad) استفاده می‌شود.
# در production بدون DATABASE_URL پایگاه ایجاد نمی‌شود. فقط برای آزمون محلیِ تک‌فرایندی:
# HERMICAD_ALLOW_PGLITE_IN_PRODUCTION=1
# این انتخاب، راه‌اندازی پایدار یا پشتیبان‌گیری تولید را فراهم نمی‌کند.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hermicad
# PGLITE_DATA_DIR=.data/hermicad
# سقف مصرف هر فضای کار (ضد سوءمصرف برای انتشار عمومی رایگان)
# HERMICAD_QUOTA_PROJECTS=200
# HERMICAD_QUOTA_DESIGNS=300
